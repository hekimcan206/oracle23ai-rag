<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OracleRag.Core\OracleRag.Core.csproj" />
    <ProjectReference Include="..\..\src\OracleRag.Synthetic\OracleRag.Synthetic.csproj" />
    <ProjectReference Include="..\..\src\OracleRag.Oracle\OracleRag.Oracle.csproj" />
    <ProjectReference Include="..\..\src\OracleRag.Postgres\OracleRag.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The exact init scripts docker compose mounts, so least privilege is tested, not assumed. -->
    <None Include="..\..\deploy\oracle\init\01-setup.sh" Link="init\oracle\01-setup.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deploy\postgres\init\01-setup.sh" Link="init\postgres\01-setup.sh" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

</Project>
