# Demo-only values for `docker compose up`. Copy to .env to override; never commit a real .env.
ORACLE_PASSWORD=sys-dev-only
ORACLE_OWNER_PASSWORD=OwnerDev1
ORACLE_APP_PASSWORD=AppDev1
POSTGRES_PASSWORD=postgres-dev-only
PG_OWNER_PASSWORD=OwnerDev1
PG_APP_PASSWORD=AppDev1
# Host ports (loopback only)
API_PORT=18424
ORACLE_PORT=15931
POSTGRES_PORT=15932
# Optional OTLP collector, e.g. http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
