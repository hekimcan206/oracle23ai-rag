{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Enabled": false
  },
  "Rag": {
    "Dimensions": 384,
    "DefaultStore": "oracle",
    "EnableMemoryStore": false,
    "Oracle": {
      "SchemaOwner": "RAG_OWNER",
      "AppUser": "RAG_APP"
    },
    "Postgres": {
      "AppUser": "rag_app"
    },
    "Seed": {
      "Entities": 40,
      "Seed": 2026,
      "CreateHnswIndex": true
    }
  },
  "ConnectionStrings": {
    "OracleApp": "",
    "OracleOwner": "",
    "PostgresApp": "",
    "PostgresOwner": ""
  }
}
